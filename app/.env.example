# Copy to app/.env.local. These credentials are read by server components only.
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# This URL is public and must be reachable by the browser.
# DigitalOcean: set this to /api at BUILD and RUN time, with /api routed to FastAPI.
NEXT_PUBLIC_API_URL=http://localhost:8000
